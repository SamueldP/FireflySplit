# GEMINI_API_KEY: Required for Gemini AI API calls (multimodal receipt OCR & classification).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREFLY_URL: The base URL of your self-hosted Firefly III instance (e.g., https://firefly.yourdomain.com or http://192.168.1.100:8080)
FIREFLY_URL="http://192.168.101.225:8585"

# FIREFLY_TOKEN: Personal Access Token generated in Firefly III under Profile -> OAuth -> Personal Access Tokens
FIREFLY_TOKEN="728776fe917fa53f83467441756c29db"

# DEFAULT_SOURCE_ACCOUNT: Default asset account name in Firefly III (e.g. "Checking Account", "Credit Card")
DEFAULT_SOURCE_ACCOUNT="Discovery"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

